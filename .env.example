PORT=4310
ORG_MEMORY_DB=./data/org-memory.sqlite
# Optional generation model for synthesized answers.
OLLAMA_GENERATION_MODEL=qwen3:8b

# Slack /context integration. Never commit real secret or token values.
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-replace-with-bot-token
SLACK_TEAM_ID=T0123456789
SLACK_ORG_SLUG=flent
# Optional alternative to users:read.email. Maps Slack user IDs to Org Memory emails.
# SLACK_USER_MAP={"U0123456789":"you@example.com"}
